# PysDev Studio Environment Configuration

# Server Port
PORT=3000

# Hosting URL (provided automatically in AI Studio / Cloud Run or local dev)
APP_URL="http://localhost:3000"

# Optional: Transactional Email Notifications (e.g. Resend)
# When provided, new qualified enquiries trigger administrative alerts
RESEND_API_KEY=""
NOTIFICATION_EMAIL="hello@pysdev.studio"

# Optional: Remote PostgreSQL / Supabase Database URL
# By default, enquiries are securely persisted to local JSON store in .data/enquiries.json
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Gemini AI API Key (if generative assistant features are configured)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
